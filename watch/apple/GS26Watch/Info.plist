<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GS26</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Direct link: stations are reached at whatever address the phone uses,
		     often plain HTTP on a LAN or a self-signed HTTPS certificate. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Crew voice uses the microphone while you hold push-to-talk.</string>
	<!-- Crew voice runs as a CallKit call so it keeps playing, recording and
	     using its socket with the wrist down (watchOS 9+ VoIP). App Store
	     review expects a real two-way voice feature for "voip".
	     "location": a recovery search track this watch's user chose to share
	     keeps recording with the wrist down (LocationService, only while
	     sharing; docs/watch-companion.md "Recovery search"). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
		<string>location</string>
	</array>
	<!-- gs26://voice: the push-to-talk complication opens the voice page. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.UBSEDS.GS26.watch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gs26</string>
			</array>
		</dict>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The recovery compass uses your watch's position to show the distance and direction to the rocket and stations. In a recovery search, only if you choose to share this watch's track, its track is sent to the station through your phone until you stop sharing or the search ends, also with the wrist down.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.UBSEDS.GS26</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
</dict>
</plist>
