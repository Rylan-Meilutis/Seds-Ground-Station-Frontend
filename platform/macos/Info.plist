<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDisplayName</key>
		<string>UBSEDS GS</string>
		<key>CFBundleName</key>
		<string>UBSEDS GS</string>
		<key>CFBundleIconFile</key>
		<string>icon.icns</string>

        <key>NSLocalNetworkUsageDescription</key>
        <string>This app connects to devices on your local network to get data from the ground station.</string>

        <key>NSLocationUsageDescription</key>
        <string>This app requires location access to help you locate your rocket.</string>

        <key>NSLocationWhenInUseUsageDescription</key>
        <string>This app requires location access to help you locate your rocket.</string>

        <key>NSCameraUsageDescription</key>
        <string>Share your camera as a Ground Station stream when you choose Start sharing.</string>

        <key>NSMicrophoneUsageDescription</key>
        <string>Use your microphone for crew voice when you choose Join voice.</string>

        <key>NSMotionUsageDescription</key>
        <string>This app uses device orientation to point the map in the direction you are facing.</string>

		<key>CFBundleExecutable</key>
		<string>groundstation_frontend</string>

		<key>CFBundleIdentifier</key>
		<string>com.UBSEDS.GS26</string>

		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>

		<key>CFBundlePackageType</key>
		<string>APPL</string>

		<key>CFBundleShortVersionString</key>
		<string>7.4.0</string>

		<key>CFBundleVersion</key>
		<string>1</string>

		<key>LSApplicationCategoryType</key>
		<string>public.app-category.social-networking</string>

		<!-- iPhone: portrait only; the header leaves no room for content in
		     landscape. iPad: every orientation, and no UIRequiresFullScreen,
		     so Split View and Slide Over work. macOS ignores these keys. -->
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIRequiresFullScreen</key>
		<false/>

		<key>LSMinimumSystemVersion</key>
		<string>10.15</string>
	</dict>
</plist>
