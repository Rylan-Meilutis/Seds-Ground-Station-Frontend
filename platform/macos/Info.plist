<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDisplayName</key>
		<string>UBSEDS GS</string>
		<key>CFBundleName</key>
		<string>UBSEDS GS</string>
		<key>CFBundleIconFile</key>
		<string>icon.icns</string>

        <key>NSLocalNetworkUsageDescription</key>
        <string>This app connects to devices on your local network to get data from the ground station.</string>

        <key>NSLocationUsageDescription</key>
        <string>This app requires location access to help you locate your rocket.</string>

        <key>NSLocationWhenInUseUsageDescription</key>
        <string>Your location helps you locate the rocket. If the station uses its proximity lock, this device tells the station only whether you are near the rocket; your location stays on this device. In a recovery search, only if you choose to share your track, your track is sent to the station until you stop sharing or the search ends.</string>

        <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
        <string>If the station uses its proximity lock, this phone keeps telling the station only whether you are near the rocket while the app is in the background, so arming and filling wait while people are at the pad. Your location stays on this phone. You can opt out in Settings > Proximity.</string>

        <!-- iOS: the proximity lock keeps reporting, and a recovery search
             track the user chose to share keeps recording, in the
             background (macOS ignores this key). -->
        <key>UIBackgroundModes</key>
        <array>
            <string>location</string>
        </array>

        <key>NSCameraUsageDescription</key>
        <string>Share your camera as a Ground Station stream when you choose Start sharing.</string>

        <key>NSMicrophoneUsageDescription</key>
        <string>Use your microphone for crew voice when you choose Join voice.</string>

        <!-- Voice, camera and recording pages are station documents loaded in
             the web view, often from a LAN address over plain HTTP or a
             .local name. App Transport Security would block them (the Rust
             HTTP client is not subject to ATS, so the rest of the app works). -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsLocalNetworking</key>
            <true/>
            <key>NSAllowsArbitraryLoadsInWebContent</key>
            <true/>
        </dict>

        <key>NSMotionUsageDescription</key>
        <string>This app uses device orientation to point the map in the direction you are facing.</string>

		<!-- Replay bundles opened from Finder, Files, AirDrop and share
		     sheets (docs/replay-bundle.md, "Opening files from other apps").
		     scripts/patch_plist.sh writes the same declarations into the
		     iOS bundle. -->
		<key>UTExportedTypeDeclarations</key>
		<array>
			<dict>
				<key>UTTypeIdentifier</key>
				<string>com.ubseds.gsreplay</string>
				<key>UTTypeDescription</key>
				<string>Ground Station replay</string>
				<key>UTTypeConformsTo</key>
				<array>
					<string>public.zip-archive</string>
					<string>public.data</string>
				</array>
				<key>UTTypeTagSpecification</key>
				<dict>
					<key>public.filename-extension</key>
					<array>
						<string>gsreplay</string>
					</array>
					<key>public.mime-type</key>
					<array>
						<string>application/vnd.seds.gsreplay+zip</string>
					</array>
				</dict>
			</dict>
		</array>
		<key>CFBundleDocumentTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeName</key>
				<string>Ground Station replay</string>
				<key>CFBundleTypeRole</key>
				<string>Viewer</string>
				<key>LSHandlerRank</key>
				<string>Owner</string>
				<key>LSItemContentTypes</key>
				<array>
					<string>com.ubseds.gsreplay</string>
				</array>
			</dict>
		</array>

		<key>CFBundleExecutable</key>
		<string>groundstation_frontend</string>

		<key>CFBundleIdentifier</key>
		<string>com.UBSEDS.GS26</string>

		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>

		<key>CFBundlePackageType</key>
		<string>APPL</string>

		<key>CFBundleShortVersionString</key>
		<string>7.4.0</string>

		<key>CFBundleVersion</key>
		<string>1</string>

		<key>LSApplicationCategoryType</key>
		<string>public.app-category.social-networking</string>

		<!-- iPhone: portrait only; the header leaves no room for content in
		     landscape. iPad: every orientation, and no UIRequiresFullScreen,
		     so Split View and Slide Over work. macOS ignores these keys. -->
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIRequiresFullScreen</key>
		<false/>

		<key>LSMinimumSystemVersion</key>
		<string>10.15</string>
	</dict>
</plist>
