<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Proximity lock (docs/proximity-lock.md): report in range / out of range
         while the app is in the background. Requested only after an in-app
         explanation, and only while the user takes part. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Wear OS companion: keep the watch publisher running while a watch is connected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <uses-feature
            android:name="android.hardware.location.gps"
            android:required="false"/>

    <application
            android:allowNativeHeapPointerTagging="false"
            android:hasCode="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:supportsRtl="true"
            android:theme="@style/AppTheme">

        <activity
                android:name="dev.dioxus.main.MainActivity"
                android:configChanges="orientation|screenLayout|screenSize|keyboardHidden"
                android:exported="true"
                android:launchMode="singleTask"
                android:label="@string/app_name">
            <meta-data android:name="android.app.lib_name" android:value="main"/>
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Replay files opened from other apps (docs/replay-bundle.md,
                 "Opening files from other apps"). singleTask: a file opened
                 while the app runs reaches the one existing activity
                 (onNewIntent) instead of starting a second web view. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/vnd.seds.gsreplay+zip"/>
            </intent-filter>
            <!-- Providers that do not know the type report a generic one;
                 the file name decides. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/json"/>
                <data android:pathPattern=".*\\.gsreplay"/>
                <data android:pathPattern=".*\\..*\\.gsreplay"/>
                <data android:pathPattern=".*\\.seds-replay\\.json"/>
                <data android:pathPattern=".*\\..*\\.seds-replay\\.json"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.seds.gsreplay+zip"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>

        <service
                android:name="com.ubseds.gs26.WatchLinkService"
                android:exported="false"
                android:foregroundServiceType="connectedDevice"/>

        <!-- Proximity lock: keeps the reporter alive in the background and
             holds the Geofencing API fence around the rocket. -->
        <service
                android:name="com.ubseds.gs26.ProximityService"
                android:exported="false"
                android:foregroundServiceType="location"/>
        <receiver
                android:name="com.ubseds.gs26.ProximityGeofenceReceiver"
                android:exported="false"/>
    </application>
</manifest>
